<nav class="auth-links" aria-label="Authentication links">
  <% if controller_name != 'sessions' %>
    <%= link_to 'Already have an account? Login', new_admin_session_path %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to 'Need a training admin? Sign up', new_admin_registration_path %>
  <% end %>

  <%= link_to 'Back to React UI', '/?api=1' %>
</nav>
