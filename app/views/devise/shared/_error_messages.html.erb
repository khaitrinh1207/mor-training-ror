<% if resource.errors.any? %>
  <section class="auth-errors" role="alert">
    <h2><%= pluralize(resource.errors.count, 'error') %> blocked this request</h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </section>
<% end %>
