<main class="auth-shell">
  <section class="auth-card" aria-labelledby="admin-login-title">
    <div class="auth-card__intro">
      <p class="auth-card__eyebrow">Admin access</p>
      <h1 id="admin-login-title">Login</h1>
      <p>Sign in to continue.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-card__form' }) do |form| %>
      <div class="auth-field">
        <%= form.label :email, 'Email address' %>
        <%= form.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'admin@example.com' %>
      </div>

      <div class="auth-field">
        <%= form.label :password %>
        <%= form.password_field :password, autocomplete: 'current-password', placeholder: 'Enter your password' %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="auth-checkbox">
          <%= form.check_box :remember_me %>
          <span>Remember this admin session</span>
        </label>
      <% end %>

      <%= form.submit 'Login', class: 'auth-card__submit' %>
    <% end %>

    <%= render 'devise/shared/links' %>
  </section>
</main>
