<main class="auth-shell">
  <section class="auth-card" aria-labelledby="admin-signup-title">
    <div class="auth-card__intro">
      <p class="auth-card__eyebrow">Create account</p>
      <h1 id="admin-signup-title">Sign up</h1>
      <p>Create an admin account to continue.</p>
    </div>

    <%= render 'devise/shared/error_messages', resource: resource %>

    <%= form_for(resource, as: resource_name, url: admin_registration_path, html: { class: 'auth-card__form' }) do |form| %>
      <div class="auth-field">
        <%= form.label :email, 'Email address' %>
        <%= form.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'admin@example.com' %>
      </div>

      <div class="auth-field">
        <%= form.label :password %>
        <% if @minimum_password_length %>
          <span class="auth-field__hint"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
        <%= form.password_field :password, autocomplete: 'new-password', placeholder: 'Create a password' %>
      </div>

      <div class="auth-field">
        <%= form.label :password_confirmation, 'Confirm password' %>
        <%= form.password_field :password_confirmation, autocomplete: 'new-password', placeholder: 'Repeat your password' %>
      </div>

      <%= form.submit 'Create admin account', class: 'auth-card__submit' %>
    <% end %>

    <%= render 'devise/shared/links' %>
  </section>
</main>
